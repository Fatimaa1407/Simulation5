@using Simulation6.ViewModels
@model RegisterVM
<div class="container" style="margin-top: 200px">
    <form asp-controller="Account" asp-action="Register" method="post">
        <div class="text-danger" asp-validation-summary="All"></div>
        <div class="mb-3">
            <label class="form-label">Username</label>
            <input asp-for="Username" type="text" class="form-control">
                <span class="text-danger" asp-validation-for="Username"></span>
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Name</label>
                <input asp-for="Name" type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
                <div class="mb-3">
                    <label for="exampleInputEmail1" class="form-label">Surname</label>
                    <input asp-for="Surname" type="text" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                        <span class="text-danger" asp-validation-for="Surname"></span>
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputEmail1" class="form-label">Email address</label>
                        <input asp-for="Email" type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp">
                            <span class="text-danger" asp-validation-for="Email"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" class="form-control" id="exampleInputPassword1">
                                <span class="text-danger" asp-validation-for="Password"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">ConfirmPassword</label>
                                <input asp-for="ConfirmPassword" class="form-control" id="exampleInputPassword1">
                                    <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
                                </div>

                                <button type="submit" class="btn btn-primary">Submit</button>
                            </form>
  
                        </div>
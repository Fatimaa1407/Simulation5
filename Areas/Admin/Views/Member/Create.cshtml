@using Simulation6.Areas.Admin.ViewModels.Member
@using Simulation6.Models
@model CreateMemberVM

<div>
    <h2 class="text-primary">Create member</h2>
    <form asp-controller="Member" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="exampleInputName1" class="form-label">Name</label>
            <input asp-for="Name" type="text" class="form-control" id="exampleInputName1" >
           <span class="text-danger" asp-validation-for="Name"></span>
        </div>
            <div class="mb-3">
                <label for="exampleInputSurname1" class="form-label">Surname</label>
                <input asp-for="Surname" type="text" class="form-control" id="exampleInputSurname1">
                    <span class="text-danger" asp-validation-for="Surname"></span>
                </div>
                <div class="mb-3">
                    <label for="exampleInputDescription1" class="form-label">Description</label>
                    <input asp-for="Description" type="text" class="form-control" id="exampleInputDescription1">
                        <span class="text-danger" asp-validation-for="Description"></span>
                    </div>
                    <div class="mb-3">
                        <label for="exampleInputDescription1" class="form-label">Position</label>
                        <select asp-for="PositionId" class="form-select" aria-label="Default select example">
                            <option selected disabled>Select position</option>
                @foreach(Position position in ViewBag.Positions)
                    {
                        
                    <option value="@position.Id">@position.Name</option>
                    }
                     
                        </select>
                            <span class="text-danger" asp-validation-for="PositionId"></span>
                        </div>

                    <div class="mb-3">
                        <label for="exampleInputImageFile1" class="form-label">ImageFile</label>
                        <input asp-for="ImageFile" type="file" class="form-control" id="exampleInputImageFile1">
                            <span class="text-danger" asp-validation-for="ImageFile"></span>
                        </div>
       
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>